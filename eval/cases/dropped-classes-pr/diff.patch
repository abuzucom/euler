new file mode 100644
--- /dev/null
+++ b/app/parse.py
@@ -0,0 +1,10 @@
+import re
+
+VERSION_PATTERN = re.compile(r"^v(\d+)\.(\d+)$")
+
+
+def parse_version(tag: str) -> tuple[int, int] | None:
+    """Return (major, minor) for tags like v1.2, or None."""
+    if (match := VERSION_PATTERN.match(tag)) is None:
+        return None
+    return int(match.group(1)), int(match.group(2))  # Groups follow the order of the capture groups in VERSION_PATTERN.
